      "on-headers@>=1.0.0 <1.1.0": "^1.1.0",
      "path-to-regexp@>=0.1.0 <0.1.13": "~0.1.13",
      "picomatch@>=2.0.0 <2.3.2": "^2.3.2",
      "postcss@>=8.0.0 <8.5.23": "^8.5.23",
      "postcss-selector-parser@>=6.0.0 <6.1.3": "^6.1.3",
      "postcss-selector-parser@>=7.0.0 <7.1.3": "^7.1.3",
      "qs@>=6.0.0 <6.16.0": "^6.16.0",
      "shell-quote@>=1.0.0 <1.9.0": "^1.9.0",
      "svgo@>=3.0.0 <3.3.5": "^3.3.5",
      "webpack@>=5.0.0 <5.104.1": "~5.104.1",
      "websocket-driver@>=0.7.0 <0.7.5": "~0.7.5",
      "ws@>=7.0.0 <7.5.11": "^7.5.11",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "serialize-javascript@<7.0.5": "^7.0.5",
      "uuid@<11.1.1": "^11.1.1"
    }
  }
}
